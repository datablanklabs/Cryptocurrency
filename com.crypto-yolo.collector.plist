<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.crypto-yolo.collector</string>

    <key>ProgramArguments</key>
    <array>
        <string>/Library/Frameworks/Python.framework/Versions/3.13/bin/python3</string>
        <string>/Users/socrates/Documents/notebooks/crypto-yolo/collect.py</string>
        <string>--catalysts</string>
        <!-- keep prices_daily fresh between trading cycles so evaluation's
             forward returns are always computed from a local record -->
        <string>--prices</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/socrates/Documents/notebooks/crypto-yolo</string>

    <!-- 00:00, 08:00 and 16:00 local time. Calendar rather than a raw
         28800s interval so the schedule stays predictable, and because
         launchd runs a missed calendar job once the Mac wakes. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Hour</key><integer>0</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>8</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Hour</key><integer>16</integer><key>Minute</key><integer>0</integer></dict>
    </array>

    <!-- Collect once at load so you get immediate confirmation it works. -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/socrates/Documents/notebooks/crypto-yolo/data/collector.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/socrates/Documents/notebooks/crypto-yolo/data/collector.log</string>

    <key>ProcessType</key>
    <string>Background</string>
    <key>LowPriorityIO</key>
    <true/>
</dict>
</plist>
